---
import Base from '../layouts/Base.astro';
---
<Base title="Пошук" description="Пошук рецептів за назвою, інгредієнтами та текстом.">
  <link slot="head" href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <h1>Пошук</h1>
  <div id="search"></div>
  <noscript><p>Для пошуку потрібен JavaScript.</p></noscript>
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (typeof PagefindUI === 'undefined') {
        document.getElementById('search').textContent = 'Пошук доступний лише на зібраному сайті.';
        return;
      }
      const ui = new PagefindUI({
        element: '#search',
        showImages: true,
        showSubResults: false,
        resetStyles: false,
        translations: {
          placeholder: 'Назва, інгредієнт…',
          clear_search: 'Очистити',
          load_more: 'Показати ще',
          search_label: 'Пошук рецептів',
          filters_label: 'Фільтри',
          zero_results: 'Нічого не знайдено за запитом [SEARCH_TERM]',
          many_results: '[COUNT] результатів за запитом [SEARCH_TERM]',
          one_result: '[COUNT] результат за запитом [SEARCH_TERM]',
          searching: 'Шукаю [SEARCH_TERM]…',
        },
      });
      const q = new URLSearchParams(location.search).get('q');
      if (q) ui.triggerSearch(q);
    });
  </script>
</Base>
